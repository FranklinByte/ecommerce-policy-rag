POLICY_RAG_ENVIRONMENT=development
POLICY_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
POLICY_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
POLICY_RAG_EMBEDDING_DEVICE=cpu
POLICY_RAG_RERANKER_DEVICE=cpu
# Compose mode only:
# POLICY_RAG_QDRANT_URL=http://qdrant:6333
# Optional OpenAI-compatible generation provider; keys are read only from environment:
# POLICY_RAG_LLM_PROVIDER=openai_compatible
# POLICY_RAG_LLM_BASE_URL=https://your-provider.example/v1
# POLICY_RAG_LLM_MODEL=your-model
# POLICY_RAG_LLM_API_KEY=replace-me

